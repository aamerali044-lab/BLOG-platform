# Get this from MongoDB Atlas: Database -> Connect -> Drivers -> copy the connection string,
# then replace <password> with your database user's password and add a database name
# after .net/ — e.g. .../blog_platform?retryWrites=true...
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blog_platform?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-string
PORT=5000
CORS_ORIGINS=http://localhost:5173
